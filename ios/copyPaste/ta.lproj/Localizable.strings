"monitoring.pipSizeHelp" = "சிறிய பயன்முறை தலைப்பை மறைத்து குறுகிய சாளரத்தைக் கோரும். உண்மையான அளவை iOS தீர்மானிக்கும். அளவை மாற்ற விரல்களால் சுருக்கவும் அல்லது மறைக்க சாளரத்தை இடது/வலது விளிம்பிற்கு இழுக்கவும். சாளரத்தின் ஒளிபுகாநிலையை மாற்ற முடியாது.";
"feedback.introduction" = "உங்களுக்கு என்ன உதவி தேவை அல்லது ClipKit-இல் என்ன அம்சம் வேண்டும் என்பதைச் சொல்லுங்கள்.";
"feedback.guidance.bug" = "நீங்கள் என்ன செய்ய முயன்றீர்கள், என்ன நடந்தது? முடிந்தால் படிகள், எதிர்பார்த்த முடிவு, நடந்த முடிவு ஆகியவற்றைச் சேர்க்கவும்.";
"feedback.guidance.feature" = "நீங்கள் என்ன செய்ய விரும்புகிறீர்கள், அது எப்போது பயனுள்ளதாக இருக்கும்? தற்போது எதிர்கொள்ளும் சிரமங்களையும் பகிரவும்.";
"feedback.guidance.other" = "உங்கள் கேள்வி அல்லது கருத்தை முடிந்தவரை விவரமாக எழுதவும்.";
"feedback.emailHelp" = "பதில் வேண்டுமெனில் மின்னஞ்சல் முகவரியை உள்ளிடவும். அது இல்லாமலும் அனுப்பலாம்.";
"feedback.deviceInfo" = "சிக்கலை ஆராய செயலி பதிப்பு, iOS பதிப்பு மற்றும் சாதன மாடல் தானாக அனுப்பப்படும். கடவுச்சொல் அல்லது ரகசியத் தகவலைச் செய்தியில் சேர்க்க வேண்டாம்.";
"feedback.failureMessage" = "உங்கள் செய்தி இங்கேயே உள்ளது. இணைப்பைச் சரிபார்த்து சிறிது நேரம் கழித்து மீண்டும் அனுப்பவும்.";
